#!/bin/sh
# devopsy: a thin wrapper around `docker compose` for projects that keep their
# deployment in a .devopsy/ directory. See README.md.
set -eu

# Colors only when stderr is a terminal.
if [ -t 2 ]; then
  red() { printf '\033[0;31m%s\033[0m\n' "$*" >&2; }
  cyan() { printf '\033[0;36m%s\033[0m\n' "$*" >&2; }
else
  red() { printf '%s\n' "$*" >&2; }
  cyan() { printf '%s\n' "$*" >&2; }
fi

# Walk up from the current directory until a .devopsy/ directory is found.
find_project_dir() {
  dir=$PWD
  while :; do
    if [ -d "$dir/.devopsy" ]; then
      printf '%s\n' "$dir/.devopsy"
      return 0
    fi
    [ "$dir" = / ] && return 1
    dir=$(dirname "$dir")
  done
}

if ! DEVOPSY_PROJECT_DIR=$(find_project_dir); then
  red ".devopsy/ not found in this directory or any parent."
  exit 100
fi
export DEVOPSY_PROJECT_DIR

if [ ! -f "$DEVOPSY_PROJECT_DIR/compose.yaml" ]; then
  red "$DEVOPSY_PROJECT_DIR/compose.yaml not found."
  exit 1
fi

# Load .env so custom commands see the same variables as compose. Variables
# already exported by the caller win, as they do in compose itself.
env_file=$DEVOPSY_PROJECT_DIR/.env
if [ -f "$env_file" ]; then
  restore=
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line#export }
    key=${line%%=*}
    [ "$key" = "$line" ] && continue
    case $key in '' | [0-9]* | *[!A-Za-z0-9_]*) continue ;; esac
    if eval "[ -n \"\${$key+x}\" ]"; then
      value=$(eval "printf '%s' \"\$$key\"" | sed "s/'/'\\\\''/g")
      restore="$restore$key='$value'; export $key; "
    fi
  done <"$env_file"
  set -a
  # shellcheck disable=SC1090
  . "$env_file"
  set +a
  eval "$restore"
fi

# Without a top-level `name:`, compose would name every project after the
# .devopsy directory, and all of them would collide. Use the parent directory
# name instead, as compose does for a compose.yaml at a project's root.
if [ -z "${COMPOSE_PROJECT_NAME:-}" ] && ! grep -q '^name:' "$DEVOPSY_PROJECT_DIR/compose.yaml"; then
  COMPOSE_PROJECT_NAME=$(basename "$(dirname "$DEVOPSY_PROJECT_DIR")" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_\n-' '-')
  export COMPOSE_PROJECT_NAME
fi

usage() {
  cat >&2 <<EOF
Usage: devopsy <command> [args...]

Runs a custom command from $DEVOPSY_PROJECT_DIR/commands/ if one exists,
otherwise passes everything to docker compose.
EOF
  if [ -d "$DEVOPSY_PROJECT_DIR/commands" ]; then
    printf '\nCustom commands:\n' >&2
    for f in "$DEVOPSY_PROJECT_DIR"/commands/*; do
      if [ -f "$f" ] && [ -x "$f" ]; then
        printf '  %s\n' "$(basename "$f")" >&2
      fi
    done
  fi
}

case "${1:-}" in
  '') usage; exit 1 ;;
  help | -h | --help) usage; exit 0 ;;
esac

# A custom command can call `devopsy <same name>` to reach the compose command
# it wraps, without recursing into itself.
if [ "${DEVOPSY_CLI_COMMAND:-}" != "$1" ] && [ -f "$DEVOPSY_PROJECT_DIR/commands/$1" ] && [ -x "$DEVOPSY_PROJECT_DIR/commands/$1" ]; then
  DEVOPSY_CLI_COMMAND=$1
  export DEVOPSY_CLI_COMMAND
  shift
  exec "$DEVOPSY_PROJECT_DIR/commands/$DEVOPSY_CLI_COMMAND" "$@"
fi

# Prepend the compose files to the user's arguments, keeping paths intact.
override=
for f in compose.override.yaml compose.override.yml; do
  if [ -f "$DEVOPSY_PROJECT_DIR/$f" ]; then
    override=$DEVOPSY_PROJECT_DIR/$f
    break
  fi
done
if [ -n "$override" ]; then
  set -- -f "$DEVOPSY_PROJECT_DIR/compose.yaml" -f "$override" "$@"
else
  set -- -f "$DEVOPSY_PROJECT_DIR/compose.yaml" "$@"
fi

cyan "Running 'docker compose $*'..."
exec docker compose "$@"
